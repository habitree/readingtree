# OpenAI API
OPENAI_API_KEY=sk-your-openai-api-key

# Supabase — 메인 DB (notes/books 조회용)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# Supabase — 쇼츠 전용 DB (콘텐츠/파이프라인/분석)
SHORTS_SUPABASE_URL=https://your-shorts-project.supabase.co
SHORTS_SUPABASE_SERVICE_ROLE_KEY=eyJ...your-shorts-service-role-key

# Edge TTS (no API key needed - free)
# TTS_VOICE=ko-KR-SunHiNeural

# Optional: Slack/Discord webhook for pipeline notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
