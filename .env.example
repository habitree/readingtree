# Habitree Reading Hub - 환경 변수 예시 파일
# 이 파일을 복사하여 .env.local 파일을 생성하고 실제 값으로 채워주세요.

# ============================================
# Supabase 설정
# ============================================
# Supabase 프로젝트 URL (예: https://xxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url

# Supabase Anon Key (공개 키, 클라이언트에서 사용)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Key (서버 전용, 민감한 작업에 사용)
# 주의: 이 키는 절대 클라이언트에 노출되면 안 됩니다!
# 현재 프로젝트에서는 사용하지 않지만, 향후 확장을 위해 포함
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ============================================
# Music Supabase (별도 프로젝트 — 음악 데이터 전용)
# ============================================
# 음악 데이터 전용 Supabase 프로젝트 URL
NEXT_PUBLIC_SUPABASE_MUSIC_URL=your_music_supabase_url

# 음악 데이터 전용 Supabase Anon Key (읽기 전용, 인증 불필요)
NEXT_PUBLIC_SUPABASE_MUSIC_ANON_KEY=your_music_supabase_anon_key

# ============================================
# Naver 검색 API
# ============================================
# 네이버 개발자 센터에서 발급받은 Client ID
NAVER_CLIENT_ID=your_naver_client_id

# 네이버 개발자 센터에서 발급받은 Client Secret
NAVER_CLIENT_SECRET=your_naver_client_secret

# ============================================
# Google Gemini API (OCR 기능)
# ============================================
# Google AI Studio에서 발급받은 API Key
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# ============================================
# OpenAI API (AI 채팅/리포트/자동 태그)
# ============================================
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# ============================================
# Polar 결제 (포인트 충전)
# ============================================
# https://polar.sh/dashboard/settings
POLAR_ACCESS_TOKEN=your_polar_access_token
POLAR_WEBHOOK_SECRET=your_polar_webhook_secret
# sandbox | production
POLAR_ENVIRONMENT=sandbox

# ============================================
# Kakao JavaScript SDK
# ============================================
# 카카오 개발자 센터에서 발급받은 JavaScript 키
# 주의: NEXT_PUBLIC_ 접두사가 있어야 클라이언트에서 사용 가능합니다
# https://developers.kakao.com/console/app
NEXT_PUBLIC_KAKAO_APP_KEY=your_kakao_javascript_key

# ============================================
# 도서 페이지 수 조회 API (복합 전략)
# ============================================
# 국립중앙도서관 ISBN서지정보 API (한국 도서 최고 커버리지)
# 발급: https://www.data.go.kr/data/3078982/openapi.do
NL_SEOJI_CERT_KEY=your_nl_seoji_cert_key

# 알라딘 Open API (한국 최대 온라인 서점)
# 발급: https://blog.aladin.co.kr/openapi/5353304
ALADIN_TTB_KEY=your_aladin_ttb_key

# Google Books API (글로벌 폴백)
# 발급: https://console.cloud.google.com/apis/credentials
# 선택사항: 키 없이도 제한적으로 사용 가능
GOOGLE_BOOKS_API_KEY=your_google_books_api_key

# ============================================
# Google Analytics (GA4)
# ============================================
# Google Analytics 측정 ID (G-XXXXXXXXXX 형식)
# 발급: https://analytics.google.com/ → 관리 → 데이터 스트림 → 측정 ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# 토스페이먼츠 결제 [INACTIVE — 사업자 등록 후 재활성화 예정]
# lib/payment/config.ts의 IS_TOSS_ENABLED = true로 전환 시 활성화
# ============================================
# NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_xxxxxxxxxxxx
# TOSS_SECRET_KEY=test_sk_xxxxxxxxxxxx
# TOSS_WEBHOOK_SECRET=your_toss_webhook_secret

# ============================================
# 애플리케이션 설정
# ============================================
# 애플리케이션의 기본 URL
# 로컬 개발: http://localhost:3000
# 프로덕션: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
